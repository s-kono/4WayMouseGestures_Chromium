{
  "manifest_version": 3,
  "name": "4Way Mouse Gestures",
  "version": "0.1",
  "description": "Right-click drag 4-direction mouse gestures (up=reload, down=close, left=back, right=forward) with red trail visualization.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

